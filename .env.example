# Copy to .env for local use. NEVER commit real values. On Railway, set these as service Variables.

# --- AI Front Desk (existing) ---
ANTHROPIC_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=+1XXXXXXXXXX
# Public https URL Twilio calls, no trailing slash. Used to verify Twilio signatures.
PUBLIC_BASE_URL=https://your-service.up.railway.app
# Bearer token for /leads and /dispatch/admin/health. At least 24 random characters.
ADMIN_API_TOKEN=

# --- Dispatch (OFF unless DISPATCH_ENABLED=true) ---
DISPATCH_ENABLED=false
# JSON map of GHL locationId -> secret (>= 32 chars, unique per client). GHL workflow Webhook sends it as
# a custom header:  Authorization: Bearer <secret>
DISPATCH_WEBHOOK_SECRETS={"BjB46xGWbqptCmiilMpx":"replace-with-32+-random-characters"}
# Must live on persistent storage (Railway volume). Do not use :memory:
DISPATCH_DB_PATH=/data/dispatch.db
GHL_PRIVATE_INTEGRATION_TOKEN=
GHL_CALENDAR_ID=
# Stays false until a supervised test is approved. When false, nothing is written to GHL.
GHL_WRITES_ENABLED=false
